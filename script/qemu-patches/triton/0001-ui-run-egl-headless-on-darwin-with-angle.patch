diff --git a/ui/egl-headless-metal.m b/ui/egl-headless-metal.m
new file mode 100644
index 000000000..5841790a6
--- /dev/null
+++ b/ui/egl-headless-metal.m
@@ -0,0 +1,92 @@
+/*
+ * Veil experiment: read a Metal scanout texture back into the 2D console
+ * surface so egl-headless (VNC, screendump) shows Neptune/virgl scanouts.
+ */
+#include "qemu/osdep.h"
+#include "ui/egl-headless-metal.h"
+#import <Metal/Metal.h>
+
+static id<MTLCommandQueue> queue;
+static id<MTLBuffer> staging;
+
+void *egl_headless_metal_retain(void *tex)
+{
+    return [(id<MTLTexture>)tex retain];
+}
+
+void egl_headless_metal_release(void *tex)
+{
+    [(id<MTLTexture>)tex release];
+}
+
+bool egl_headless_metal_read(void *texture, uint32_t x, uint32_t y,
+                             uint32_t w, uint32_t h,
+                             uint8_t *dst, size_t dst_stride)
+{
+    id<MTLTexture> tex = (id<MTLTexture>)texture;
+    bool swap_rb;
+    size_t row = (size_t)w * 4;
+
+    if (!tex || !w || !h) {
+        return false;
+    }
+    switch (tex.pixelFormat) {
+    case MTLPixelFormatBGRA8Unorm:
+    case MTLPixelFormatBGRA8Unorm_sRGB:
+        swap_rb = false;
+        break;
+    case MTLPixelFormatRGBA8Unorm:
+    case MTLPixelFormatRGBA8Unorm_sRGB:
+        swap_rb = true;
+        break;
+    default:
+        fprintf(stderr, "egl-headless: unsupported metal format %lu\n", (unsigned long)tex.pixelFormat);
+        return false;
+    }
+    if (x + w > tex.width || y + h > tex.height) {
+        return false;
+    }
+    @autoreleasepool {
+        if (!queue || queue.device != tex.device) {
+            [queue release];
+            queue = [tex.device newCommandQueue];
+            [staging release];
+            staging = nil;
+        }
+        if (!staging || staging.length < row * h) {
+            [staging release];
+            staging = [tex.device newBufferWithLength:row * h
+                                              options:MTLResourceStorageModeShared];
+        }
+        id<MTLCommandBuffer> cb = [queue commandBuffer];
+        id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+        [blit copyFromTexture:tex
+                  sourceSlice:0
+                  sourceLevel:0
+                 sourceOrigin:MTLOriginMake(x, y, 0)
+                   sourceSize:MTLSizeMake(w, h, 1)
+                     toBuffer:staging
+            destinationOffset:0
+       destinationBytesPerRow:row
+     destinationBytesPerImage:row * h];
+        [blit endEncoding];
+        [cb commit];
+        [cb waitUntilCompleted];
+        const uint8_t *src = staging.contents;
+        for (uint32_t r = 0; r < h; r++) {
+            uint8_t *d = dst + r * dst_stride;
+            const uint8_t *s = src + r * row;
+            if (!swap_rb) {
+                memcpy(d, s, row);
+            } else {
+                for (uint32_t c = 0; c < w; c++) {
+                    d[c * 4 + 0] = s[c * 4 + 2];
+                    d[c * 4 + 1] = s[c * 4 + 1];
+                    d[c * 4 + 2] = s[c * 4 + 0];
+                    d[c * 4 + 3] = 0xff;
+                }
+            }
+        }
+    }
+    return true;
+}
