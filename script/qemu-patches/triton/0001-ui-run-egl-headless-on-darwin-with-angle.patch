+                                surface_stride(edpy->ds))) {
+        dpy_gfx_update(edpy->dcl.con, 0, 0, w, h);
+    } else {
+        static int warned;
+        if (warned++ < 5) {
+            fprintf(stderr, "egl-headless: metal readback failed %ux%u+%u+%u surf %dx%d\n",
+                    w, h, edpy->mtl_x, edpy->mtl_y,
+                    surface_width(edpy->ds), surface_height(edpy->ds));
+        }
+    }
+#endif
+}
+
 static void egl_refresh(DisplayChangeListener *dcl)
 {
+    egl_dpy *edpy = container_of(dcl, egl_dpy, dcl);
+
     graphic_hw_update(dcl->con);
+    egl_metal_readback(edpy);
 }
 
