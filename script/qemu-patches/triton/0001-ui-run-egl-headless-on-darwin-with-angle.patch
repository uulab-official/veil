     /* source framebuffer */
     egl_fb_setup_for_tex(&edpy->guest_fb,
@@ -78,6 +157,8 @@ static void egl_scanout_texture(DisplayChangeListener *dcl,
         egl_fb_destroy(&edpy->blit_fb);
         egl_fb_setup_new_tex(&edpy->blit_fb, backing_width, backing_height);
