 }
 
 #ifdef CONFIG_GBM
@@ -145,11 +226,64 @@ static void egl_scanout_flush(DisplayChangeListener *dcl,
 {
     egl_dpy *edpy = container_of(dcl, egl_dpy, dcl);
 
+    if (edpy->mtl_tex) {
+        edpy->mtl_dirty = true;
+        return;
+    }
     if (!edpy->guest_fb.texture || !edpy->ds) {
         return;
     }
     assert(surface_format(edpy->ds) == PIXMAN_x8r8g8b8);
+    EGL_HL_ENTER();
 
+#ifdef __APPLE__
+    {
+        /*
+         * Veil experiment: GLES (ANGLE) cannot blit between the guest's
+         * texture format and a BGRA blit target, so read the guest
+         * framebuffer directly as RGBA and fix order/orientation on the CPU.
+         */
+        int sw = MIN(surface_width(edpy->ds), edpy->guest_fb.width);
+        int sh = MIN(surface_height(edpy->ds), edpy->guest_fb.height);
+        int stride = surface_stride(edpy->ds);
+        uint8_t *base = (uint8_t *)surface_data(edpy->ds);
+        GLenum err;
+
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, edpy->guest_fb.framebuffer);
+        glPixelStorei(GL_PACK_ROW_LENGTH, stride / 4);
+        glReadPixels(0, 0, sw, sh, GL_RGBA, GL_UNSIGNED_BYTE, base);
+        glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+        err = glGetError();
+        EGL_HL_LEAVE();
+        if (err != GL_NO_ERROR) {
+            static int warned;
+            if (warned++ < 5) {
+                fprintf(stderr, "egl-headless: guest read error 0x%x\n", err);
+            }
+            return;
+        }
+        for (int r = 0; r < sh; r++) {
+            uint8_t *p = base + r * stride;
+            for (int c = 0; c < sw; c++, p += 4) {
+                uint8_t t = p[0];
+                p[0] = p[2];
+                p[2] = t;
+            }
+        }
+        if (!edpy->y_0_top) {
+            g_autofree uint8_t *tmp = g_malloc(stride);
+            for (int r = 0; r < sh / 2; r++) {
+                uint8_t *a = base + r * stride;
+                uint8_t *b = base + (sh - 1 - r) * stride;
+                memcpy(tmp, a, stride);
+                memcpy(a, b, stride);
+                memcpy(b, tmp, stride);
+            }
+        }
+        dpy_gfx_update(edpy->dcl.con, x, y, w, h);
+        return;
+    }
+#endif
     if (edpy->cursor_fb.texture) {
         /* have cursor -> render using textures */
         egl_texture_blit(edpy->gls, &edpy->blit_fb, &edpy->guest_fb,
@@ -162,7 +296,14 @@ static void egl_scanout_flush(DisplayChangeListener *dcl,
         egl_fb_blit(&edpy->blit_fb, &edpy->guest_fb, edpy->y_0_top);
     }
 
+    {
+        static int n;
+        if (n++ % 600 == 0) {
+            fprintf(stderr, "egl-headless: flush #%d %ux%u+%u+%u\n", n, w, h, x, y);
+        }
+    }
     egl_fb_read(edpy->ds, &edpy->blit_fb);
+    EGL_HL_LEAVE();
     dpy_gfx_update(edpy->dcl.con, x, y, w, h);
