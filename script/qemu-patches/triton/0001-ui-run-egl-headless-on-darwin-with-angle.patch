+#ifndef UI_EGL_HEADLESS_METAL_H
+#define UI_EGL_HEADLESS_METAL_H
+
+void *egl_headless_metal_retain(void *tex);
+void egl_headless_metal_release(void *tex);
+bool egl_headless_metal_read(void *texture, uint32_t x, uint32_t y,
+                             uint32_t w, uint32_t h,
+                             uint8_t *dst, size_t dst_stride);
+
