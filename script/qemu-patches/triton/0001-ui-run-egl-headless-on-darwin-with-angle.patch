+
+static void egl_metal_readback(egl_dpy *edpy)
+{
+#ifdef __APPLE__
+    uint32_t w, h;
+
+    if (!edpy->mtl_tex || !edpy->ds || !edpy->mtl_dirty) {
+        return;
+    }
+    edpy->mtl_dirty = false;
+    w = MIN(edpy->mtl_w, (uint32_t)surface_width(edpy->ds));
+    h = MIN(edpy->mtl_h, (uint32_t)surface_height(edpy->ds));
+    if (egl_headless_metal_read(edpy->mtl_tex, edpy->mtl_x, edpy->mtl_y, w, h,
