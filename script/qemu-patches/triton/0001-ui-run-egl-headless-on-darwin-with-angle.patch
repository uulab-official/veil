@@ -180,8 +180,32 @@ void egl_fb_read(DisplaySurface *dst, egl_fb *src)
 {
     glBindFramebuffer(GL_READ_FRAMEBUFFER, src->framebuffer);
     glReadBuffer(GL_COLOR_ATTACHMENT0_EXT);
+#ifdef __APPLE__
+    {
+        /* Veil experiment: ANGLE/GLES may refuse BGRA reads; read RGBA and swap */
+        int n = surface_width(dst) * surface_height(dst);
+        uint8_t *p = (uint8_t *)surface_data(dst);
+        GLenum err;
+        glReadPixels(0, 0, surface_width(dst), surface_height(dst),
+                     GL_RGBA, GL_UNSIGNED_BYTE, p);
+        err = glGetError();
+        if (err != GL_NO_ERROR) {
+            static int warned;
+            if (warned++ < 5) {
+                fprintf(stderr, "egl_fb_read: glReadPixels error 0x%x\n", err);
+            }
+            return;
+        }
+        for (int i = 0; i < n; i++, p += 4) {
+            uint8_t t = p[0];
+            p[0] = p[2];
+            p[2] = t;
+        }
+    }
+#else
     glReadPixels(0, 0, surface_width(dst), surface_height(dst),
                  GL_BGRA, GL_UNSIGNED_BYTE, surface_data(dst));
+#endif
 }
 
