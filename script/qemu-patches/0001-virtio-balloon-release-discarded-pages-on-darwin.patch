+/*
+ * Darwin's MADV_DONTNEED only lowers a page's priority: the page stays
+ * resident, keeps its contents and still counts against QEMU's footprint, so
+ * an inflated balloon gave nothing back to macOS. MADV_FREE_REUSABLE lets the
+ * kernel take the pages and drops them from the footprint at once.
+ */
+static void balloon_discard_range(RAMBlock *rb, ram_addr_t offset, size_t size)
+{
+    ram_block_discard_range(rb, offset, size);
+#ifdef __APPLE__
+    madvise(qemu_map_ram_ptr(rb, offset), size, MADV_FREE_REUSABLE);
+#endif
 }
 
