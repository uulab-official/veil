+static void balloon_unmark_subpage(VirtIOBalloon *balloon, ram_addr_t base_gpa,
+                                   int subpage)
+{
+    gpointer key = (gpointer)(uintptr_t)base_gpa;
+    uint64_t mask;
+
+    if (!balloon->partial_host_pages) {
+        return;
+    }
+    mask = (uint64_t)(uintptr_t)g_hash_table_lookup(balloon->partial_host_pages,
+                                                     key);
+    mask &= ~(1ULL << subpage);
+    if (mask) {
+        g_hash_table_insert(balloon->partial_host_pages, key,
+                            (gpointer)(uintptr_t)mask);
+    } else {
+        g_hash_table_remove(balloon->partial_host_pages, key);
+    }
+}
